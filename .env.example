# Токен от @BotFather. Файл .env в .gitignore — настоящий токен
# в репозиторий не попадает.
BOT_TOKEN=123456:AA...

# Адрес мини-приложения. Обязательно https, иначе Telegram его не откроет
# и кнопка приложения просто не будет показана.
WEBAPP_URL=https://rouk69.github.io/miet-app

# Кому открыта админка. Числовые id через запятую — свой можно узнать у
# @userinfobot. Пока переменная пуста, админку не увидит никто: роли
# раздаются изнутри, а первый ключ взять больше неоткуда.
ADMIN_IDS=

# Порт HTTP-API. В облаке наружу смотрит только 80-й, поэтому там его не
# задают вовсе; локально 80 требует прав администратора — берём другой.
PORT=8080

# Откуда разрешено обращаться к API. Звёздочка по умолчанию: личных данных
# он не отдаёт никому, кроме владельца подписанной initData. Сузить до
# адреса мини-приложения можно так:
# ALLOW_ORIGIN=https://rouk69.github.io
